{
  "name": "sunny-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Sunny.ai â€” multi-tenant AI assistant platform for solar installers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firestore": "node scripts/firestore-emulator.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sunscan.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:widget && npm run build:lab",
    "build:widget": "node packages/widget/scripts/build.mjs",
    "build:lab": "node apps/character-lab/scripts/build.mjs",
    "build:widget-demo-react": "npm run build -w @sunny/widget-demo-react",
    "build:widget-demo-next": "npm run build -w @sunny/widget-demo-next",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:widget-demo": "tsx apps/widget-demo/serve.ts",
    "dev:widget-demo-react": "tsx apps/widget-demo-react/serve.ts",
    "dev:widget-demo-next": "npm run dev -w @sunny/widget-demo-next",
    "dev:lab": "tsx apps/character-lab/serve.ts",
    "dev:marketing": "npm run dev -w @sunny/marketing",
    "smoke": "node scripts/smoke-api.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify:all": "npm run verify && npm run build:widget && npm run build:widget-demo-react && npm run build:widget-demo-next && npm run build:marketing && npm run test:e2e",
    "render:samples": "npm run render -w @sunny/character",
    "build:marketing": "npm run build -w @sunny/marketing",
    "build:tokens": "npm run build:tokens -w @sunny/ui",
    "test:visual:update": "tsx scripts/update-visual-baselines.ts",
    "seed:catalogue": "tsx scripts/seed-catalogue.ts",
    "seed:hsenergy": "tsx scripts/seed-hsenergy-catalogue.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "verify:isolation": "tsx scripts/verify-isolation.ts",
    "perf:marketing": "node scripts/lighthouse-marketing.mjs",
    "test:auth-emulator": "node scripts/ensure-jre.mjs && node scripts/auth-emulator.mjs",
    "test:e2e:auth-firebase": "playwright test --config tests/e2e/auth-firebase.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.6.5",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "firebase-tools": "^14.27.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
