{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Set for the React host fixture in `apps/widget-demo-react`, which is the
    // only `.tsx` in the repository. The widget itself ships no framework: the
    // fixture exists precisely to check that it works in one.
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@sunny/contracts": ["./packages/contracts/src/index.ts"],
      "@sunny/character": ["./packages/character/src/index.ts"],
      "@sunny/animation-engine": ["./packages/animation-engine/src/index.ts"],
      "@sunny/games": ["./packages/games/src/index.ts"],
      "@sunny/ui": ["./packages/ui/src/index.ts"],
      "@sunny/solar-rules": ["./packages/solar-rules/src/index.ts"],
      "@sunny/knowledge": ["./packages/knowledge/src/index.ts"],
      "@sunny/quote-engine": ["./packages/quote-engine/src/index.ts"]
      // The SunScan packages are deliberately absent here. They are vendored
      // from SunScanV2 and compile under its own settings (tsconfig.sunscan.json);
      // this project sees the adapter and the viewer through their declared
      // public APIs instead, selected by the `sunny-facade` condition below and
      // checked against the implementation inside the SunScan project.
    },
    "customConditions": ["sunny-facade"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/test/**/*.ts",
    "apps/*/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  // The Next.js fixture brings its own tsconfig, because Next needs `jsx:
  // preserve` and generates route types of its own. Without this it is caught
  // twice -- once by `apps/*/*.ts`, which matches its generated `next-env.d.ts`
  // and checks it against settings Next does not use.
  "exclude": [
    "node_modules",
    "apps/widget-demo-next",
    "apps/marketing",
    // Vendored from SunScanV2 and type-checked by tsconfig.sunscan.json.
    "packages/sunscan-core",
    "packages/sunscan-engine",
    "packages/sunscan-viewer",
    "packages/sunscan-adapter"
  ]
}
