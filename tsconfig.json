{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Set for the React host fixture in `apps/widget-demo-react`, which is the
    // only `.tsx` in the repository. The widget itself ships no framework: the
    // fixture exists precisely to check that it works in one.
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@sunny/contracts": ["./packages/contracts/src/index.ts"],
      "@sunny/character": ["./packages/character/src/index.ts"],
      "@sunny/animation-engine": ["./packages/animation-engine/src/index.ts"],
      "@sunny/ui": ["./packages/ui/src/index.ts"],
      "@sunny/solar-rules": ["./packages/solar-rules/src/index.ts"],
      "@sunny/sunscan-adapter": ["./packages/sunscan-adapter/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/test/**/*.ts",
    "apps/*/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ]
}
