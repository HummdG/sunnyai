# Copy to `env/<environment>.tfvars` and fill in. Do not commit the copy: it
# names a real project, and the values differ per environment by definition.

project_id  = "your-gcp-project"
region      = "europe-west2"
environment = "staging"

# The exact artifact to run. Name a digest where you can: a tag can be moved
# under you, and then the same Terraform state describes two different builds.
api_image = "europe-west2-docker.pkg.dev/your-gcp-project/sunny-staging/sunny-api:0.1.0"

# Every origin that is allowed to open a widget session. The API refuses to boot
# in production with this empty, so an incomplete list is a loud failure rather
# than an open door. Include the website's own URL (site_url): its chat and its
# waitlist form both call the API from there.
allowed_origins = [
  "https://staging.example.com",
]

# Leave 0 to scale to zero. Raise it when the cold start on a visitor's first
# turn costs more than the idle instance does.
api_min_instances = 0

# The ceiling that protects the budget.
api_max_instances = 4

# The website and dashboard image (apps/marketing/Dockerfile). Its NEXT_PUBLIC_*
# settings are compiled in at build time, so build it per environment.
web_image = "europe-west2-docker.pkg.dev/your-gcp-project/sunny-staging/sunny-web:0.1.0"

# Where the Firestore database lives. Permanent once created: decide before the
# first apply.
firestore_location = "europe-west2"

# Public URLs, with no trailing slash. The Cloud Run URLs from the first apply
# (`terraform output web_url` / `api_url`) until a domain is mapped.
site_url     = "https://staging.example.com"
api_base_url = ""

# A custom domain (domain.tf): leave these out to stay on run.app URLs. With
# them, the apply prints `dns_records` to add at the registrar, and site_url /
# api_base_url above should name these hostnames once the certificate is ACTIVE.
# web_domains          = ["heysunny.co.uk"]
# web_redirect_domains = ["www.heysunny.co.uk"]
# api_domains          = ["api.heysunny.co.uk"]

# Who hears about it when the API, chat or the website stops answering.
alert_email = "you@example.com"

# Billing. Fill both Stripe secrets in Secret Manager first (see
# `terraform output stripe_secret_ids`), then turn this on. Price ids are the
# four monthly GBP prices: Base 199, Email 99, Voice 199, Full Suite 449.
stripe_enabled = false
stripe_price_ids = {
  # base  = "price_..."
  # email = "price_..."
  # voice = "price_..."
  # suite = "price_..."
}
