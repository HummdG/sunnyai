{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Next requires these, and they differ from the repository's defaults:
    // `preserve` leaves JSX for Next's compiler to transform, and the plugin
    // supplies the App Router's types.
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
