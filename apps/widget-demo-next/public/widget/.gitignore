# The widget bundle, copied here by `scripts/copy-widget.mjs` so Next can serve
# it the way an integrator's own site would. Excluded by a local ignore rather
# than a rule in the root .gitignore so that the directory itself stays in the
# repository and the fixture does not need `mkdir` before it can build.
sunny-widget.js
sunny-widget.js.map

# The parts the widget loads on demand from beside itself: the 3D roof and
# the voice call. Copied with the bundle, and as much a build artefact.
sunny-roof.js
sunny-voice.js

# The typeface, copied in with the bundle (D-48). A build artefact like the two
# above it: the canonical files are committed once, in `packages/ui/fonts/`.
fonts/
