# The widget bundle, copied here by `scripts/copy-widget.mjs` so the marketing
# site can embed the real thing from its own origin. Ignored by a local rule so
# the directory itself stays in the repository and the build does not need
# `mkdir` first.
sunny-widget.js
sunny-widget.js.map

# The parts the widget loads on demand from beside itself: the 3D roof and
# an installer's animated logo.
# Copied with the bundle, and as much a build artefact.
sunny-roof.js
sunny-logo.js

# The typeface, copied in with the bundle (D-48). A build artefact like the
# files above it: the canonical files are committed once, in `packages/ui/fonts/`.
fonts/
