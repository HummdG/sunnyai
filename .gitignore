# Runtime data written by the API while tests and smoke checks run: conversation
# transcripts and captured leads, appended to on every run. Committing these made
# each smoke run dirty the tree and put a fake "Smoke Test" lead into history --
# the installer dashboard reads leads, so a committed one is a phantom enquiry.
.data*/

*.log
.env
.env.local
.env.*.local
.venv/
__pycache__/
*.pyc

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
terraform.tfvars
*.auto.tfvars

# Local secret material — never commit
*.pem
*.key
service-account*.json
credentials.json

# Character render output
packages/character/out/

# The React host fixture's bundle. Unlike the character lab's, which is small
# enough to commit so its page works with no build step, this is a 3.6 MB
# unminified React development build: no benefit to committing it, and a fresh
# 3.6 MB blob on every dependency bump. Built by `npm run build:widget-demo-react`,
# and rebuilt by the Playwright server before the fixture is served.
apps/widget-demo-react/public/app.js
