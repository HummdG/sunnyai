# Local development settings for the Sunny API (apps/api).
#
# Copy this file to `.env` in the repo root and fill in what you need. `.env`
# is gitignored; never commit a real key. Variables already set in your shell
# take precedence over this file. Deployments set these on Cloud Run instead.

# ── Chat ─────────────────────────────────────────────────────────────────────
# Without a key, chat is disabled (never simulated). Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model.
# GEMINI_MODEL=

# ── Admin ────────────────────────────────────────────────────────────────────
# Enables the admin routes (catalogue upload, knowledge sources, leads, metrics).
# Any long random string works locally.
# SUNNY_ADMIN_TOKEN=

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=8787
# WIDGET_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4176
# SESSION_SECRET=change-me-for-anything-shared
